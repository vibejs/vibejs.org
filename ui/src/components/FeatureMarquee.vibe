<script setup lang="ts">
import { t } from '../i18n.ts';
import type { MessageKey } from '../messages.ts';
const FEATURES = Array.from({ length: 10 }, (_, i) => `feature.${i + 1}` as MessageKey);
// Two copies side by side, so the strip loops without a gap.
const items = [...FEATURES, ...FEATURES];
</script>

<template>
  <div
    dir="ltr"
    class="group relative overflow-hidden py-2 [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]"
    :aria-label="t('home.features')"
  >
    <ul class="animate-marquee flex w-max gap-3 group-hover:[animation-play-state:paused]">
      <li
        v-for="(feature, index) in items"
        :key="index"
        :aria-hidden="index >= FEATURES.length"
        class="bg-background/60 text-muted-foreground flex items-center gap-2 rounded-full border px-4 py-2 text-sm whitespace-nowrap backdrop-blur"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="text-foreground size-3.5 fill-none stroke-current stroke-[2.5]">
          <path d="m5 12 5 5 9-10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {{ t(feature) }}
      </li>
    </ul>
  </div>
</template>

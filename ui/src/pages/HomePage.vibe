<script setup lang="ts">
import { RouterLink } from '@usevibejs/ui/router';
import { computed, ref } from '@usevibejs/ui';
import { locale, localePath, t } from '../i18n.ts';
import CheckRun from '../components/CheckRun.vibe';
import CreateCommand from '../components/CreateCommand.vibe';
import FeatureMarquee from '../components/FeatureMarquee.vibe';
import HeroBackdrop from '../components/HeroBackdrop.vibe';
import LiveDemo from '../components/LiveDemo.vibe';
import PartsTabs from '../components/PartsTabs.vibe';
import check from '../snippets/check.md';
import checkJson from '../snippets/check-json.md';

const headline = computed(() => t('home.title').split(' '));
const lp = (path: string) => localePath(path, locale.value);

// A slight 3D tilt toward a fine pointer; touch screens keep the card flat.
const tiltStyle = ref<Record<string, string>>({});
function tilt(event: PointerEvent) {
  if (event.pointerType !== 'mouse' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const box = (event.currentTarget as HTMLElement).getBoundingClientRect();
  const x = (event.clientX - box.left) / box.width - 0.5;
  const y = (event.clientY - box.top) / box.height - 0.5;
  tiltStyle.value = { transform: `rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 8).toFixed(2)}deg)` };
}
function untilt() {
  tiltStyle.value = {};
}

const primary =
  'bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-5 text-sm font-medium shadow-xs';
const outline =
  'bg-background hover:bg-accent inline-flex h-10 items-center justify-center rounded-md border px-5 text-sm font-medium shadow-xs';
const section = 'border-t py-16 sm:py-20';
const heading = 'text-2xl font-semibold tracking-tight text-balance sm:text-3xl';
const lede = 'text-muted-foreground mt-3 max-w-2xl text-base leading-7';

const FACTS = [1, 2, 3, 4] as const;
</script>

<template>
  <main class="mx-auto max-w-screen-xl px-4 sm:px-6">
    <section
      class="relative isolate grid grid-cols-[minmax(0,1fr)] gap-14 pt-12 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:pt-24 lg:pb-28"
      aria-labelledby="hero-title"
    >
      <HeroBackdrop />
      <div>
        <RouterLink
          :to="lp('/v0/guides/getting-started')"
          class="animate-fade-up bg-background/70 relative mb-6 inline-flex items-center gap-2 overflow-hidden rounded-full border px-3 py-1 text-xs font-medium backdrop-blur"
        >
          <span class="border-beam" aria-hidden="true"></span>
          <span class="relative flex size-2">
            <span class="bg-foreground absolute inline-flex size-full animate-ping rounded-full opacity-40"></span>
            <span class="bg-foreground relative inline-flex size-2 rounded-full"></span>
          </span>
          {{ t('home.badge') }}
          <svg viewBox="0 0 24 24" aria-hidden="true" class="flip-rtl text-muted-foreground size-3.5 fill-none stroke-current stroke-2">
            <path d="m9 6 6 6-6 6" stroke-linecap="round" />
          </svg>
        </RouterLink>
        <h1 id="hero-title" class="text-[2.5rem] leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl sm:tracking-tighter lg:text-7xl">
          <template v-for="(word, index) in headline" :key="`${locale}-${index}`">
            <span class="animate-blur-in inline-block" :style="{ animationDelay: `${150 + index * 110}ms` }">{{ word }}</span>{{ index < headline.length - 1 ? ' ' : '' }}
          </template>
        </h1>
        <p class="animate-fade-up text-muted-foreground mt-6 max-w-xl text-base leading-7 [animation-delay:600ms] sm:text-lg">
          {{ t('home.lede') }}
        </p>
        <div class="animate-fade-up mt-8 max-w-xl [animation-delay:750ms]">
          <CreateCommand />
        </div>
        <div class="animate-fade-up mt-4 flex flex-col gap-2 [animation-delay:850ms] sm:flex-row">
          <RouterLink :to="lp('/tutorial')" :class="[primary, 'group relative overflow-hidden']">
            <span
              class="animate-shine pointer-events-none absolute inset-y-0 start-0 w-1/3 bg-gradient-to-r from-transparent via-white/25 to-transparent dark:via-black/15"
              aria-hidden="true"
            ></span>
            {{ t('home.tryIt') }}
          </RouterLink>
          <RouterLink :to="lp('/v0/')" :class="outline">{{ t('home.readDocs') }}</RouterLink>
        </div>
      </div>
      <div
        class="animate-fade-up relative [animation-delay:400ms] [perspective:1200px]"
        @pointermove="tilt"
        @pointerleave="untilt"
      >
        <div class="relative transition-transform duration-300 ease-out will-change-transform" :style="tiltStyle">
          <div class="relative rounded-xl">
            <LiveDemo />
            <span class="border-beam z-10" aria-hidden="true"></span>
          </div>
          <div class="animate-fade-up relative mt-4 [animation-delay:900ms] sm:ms-auto sm:w-80">
            <CheckRun />
          </div>
        </div>
      </div>
    </section>

    <div class="animate-fade-up -mx-4 mb-4 [animation-delay:1000ms] sm:-mx-6">
      <FeatureMarquee />
    </div>

    <section :class="section" aria-labelledby="nodes-title">
      <h2 id="nodes-title" :class="heading">{{ t('home.nodes.title') }}</h2>
      <p :class="lede">{{ t('home.nodes.text') }}</p>
      <RouterLink :to="lp('/v0/ui/reactivity')" class="mt-4 inline-block text-sm font-medium underline underline-offset-4">
        {{ t('home.nodes.link') }}
      </RouterLink>
    </section>

    <section :class="[section, 'grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16']" aria-labelledby="parts-title">
      <div>
        <h2 id="parts-title" :class="heading">{{ t('home.parts.title') }}</h2>
        <p :class="lede">{{ t('home.parts.text') }}</p>
      </div>
      <PartsTabs />
    </section>

    <section :class="[section, 'grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16']" aria-labelledby="check-title">
      <div>
        <h2 id="check-title" :class="heading">{{ t('home.check.title') }}</h2>
        <p :class="[lede, 'rich']" v-html="t('home.check.text')"></p>
      </div>
      <div class="grid min-w-0 gap-3">
        <div class="code-block bg-card overflow-hidden rounded-xl border shadow-sm" v-html="check.html"></div>
        <p class="text-muted-foreground rich text-sm" v-html="t('home.check.aside')"></p>
        <div class="code-block bg-card overflow-hidden rounded-xl border shadow-sm" v-html="checkJson.html"></div>
      </div>
    </section>

    <section :class="section" aria-labelledby="agents-title">
      <div class="flex items-center gap-4">
        <img src="/logo.png" alt="" width="56" height="56" class="size-14 rounded-xl" />
        <h2 id="agents-title" :class="heading">{{ t('home.agents.title') }}</h2>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <li v-for="n in FACTS" :key="n" class="bg-card rounded-xl border p-5 shadow-xs">
          <h3 class="text-sm font-semibold">{{ t(`home.agents.f${n}.title`) }}</h3>
          <p class="text-muted-foreground rich mt-1.5 text-sm leading-6" v-html="t(`home.agents.f${n}.text`)"></p>
        </li>
      </ul>
      <RouterLink :to="lp('/v0/guides/ai-agents')" class="mt-6 inline-block text-sm font-medium underline underline-offset-4">
        {{ t('home.agents.link') }}
      </RouterLink>
    </section>

    <section class="bg-muted/50 my-6 rounded-2xl border px-5 py-10 sm:px-10 sm:py-14" aria-labelledby="start-title">
      <h2 id="start-title" :class="heading">{{ t('home.start.title') }}</h2>
      <p class="text-muted-foreground mt-2 text-sm">{{ t('home.start.requirements') }}</p>
      <div class="mt-6 max-w-xl">
        <CreateCommand />
      </div>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <RouterLink :to="lp('/v0/guides/getting-started')" :class="primary">{{ t('home.start.cta') }}</RouterLink>
        <a href="https://github.com/vibejs/vibejs" :class="outline">{{ t('home.start.source') }}</a>
      </div>
    </section>

    <footer class="text-muted-foreground flex flex-col gap-4 border-t py-8 text-sm sm:flex-row sm:items-start sm:justify-between">
      <p class="rich max-w-xl leading-6" v-html="t('footer.license')"></p>
      <nav class="text-foreground flex flex-wrap gap-x-5 gap-y-2 font-medium" :aria-label="t('footer.label')">
        <a href="https://github.com/vibejs/vibejs" class="hover:underline">GitHub</a>
        <a href="https://www.npmjs.com/org/usevibejs" class="hover:underline">npm</a>
        <RouterLink :to="lp('/v0/errors/')" class="hover:underline">{{ t('footer.errors') }}</RouterLink>
        <a href="/v0/llms.txt" class="hover:underline">llms.txt</a>
      </nav>
    </footer>
  </main>
</template>

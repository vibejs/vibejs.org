// Cloudflare Workers static assets: `pnpm build`, then `wrangler deploy`.
// Unknown paths serve index.html, so the router handles /v0/... on a fresh load.
{
  "name": "vibejs-org",
  "compatibility_date": "2026-10-01",
  // The workers.dev address stays on as a fallback; per-version preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,
  // Needs the vibejs.org zone active on the same Cloudflare account; deploy creates the DNS
  // records and certificates.
  "routes": [
    { "pattern": "vibejs.org", "custom_domain": true },
    { "pattern": "www.vibejs.org", "custom_domain": true },
  ],
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application",
  },
}

{
  "pages": [
    {
      "path": "cli/agents",
      "title": "vibejs agents",
      "description": "Write the vibe.js rules into AGENTS.md and CLAUDE.md, the vibejs-* skills into .agents/skills and .claude/skills, and the vibejs server into .mcp.json."
    },
    {
      "path": "cli/build",
      "title": "vibejs build",
      "description": "Build the UI into ui/dist and the server into server/dist/main.js."
    },
    {
      "path": "cli/check",
      "title": "vibejs check",
      "description": "Type-check, lint, format-check and test the project with coverage, concurrently."
    },
    {
      "path": "cli/components",
      "title": "vibejs components",
      "description": "List the .vibe components with their props, models and types, without running them."
    },
    {
      "path": "cli/dev",
      "title": "vibejs dev",
      "description": "Serve the UI and the backend on one port, restarting the backend on server changes."
    },
    {
      "path": "cli/di",
      "title": "vibejs di",
      "description": "Show the modules and providers of the backend, without constructing any provider."
    },
    {
      "path": "cli/docs",
      "title": "vibejs docs",
      "description": "Look up a VIBE code, open a docs page by path, or search the bundled docs, offline."
    },
    {
      "path": "cli/errors",
      "title": "vibejs errors",
      "description": "List the unresolved build errors and the latest runtime errors from .vibejs/dev.log."
    },
    {
      "path": "cli/explain",
      "title": "vibejs explain",
      "description": "Explain a VIBE error code from the bundled catalog, offline."
    },
    {
      "path": "cli/generate",
      "title": "vibejs generate",
      "description": "Add a resource, a component or a page with its tests, and register it."
    },
    {
      "path": "cli/index",
      "title": "CLI reference",
      "description": "Every vibejs command, its options and examples."
    },
    {
      "path": "cli/logs",
      "title": "vibejs logs",
      "description": "Show the newest .vibejs/dev.log entries, filtered by level, source, text and time."
    },
    {
      "path": "cli/mcp",
      "title": "vibejs mcp",
      "description": "Serve the --json commands to coding agents as MCP tools over stdio."
    },
    {
      "path": "cli/request",
      "title": "vibejs request",
      "description": "Call an API route: through the running dev server, or in process when none runs."
    },
    {
      "path": "cli/routes",
      "title": "vibejs routes",
      "description": "List the API routes and the UI routes, without starting a server or running UI code."
    },
